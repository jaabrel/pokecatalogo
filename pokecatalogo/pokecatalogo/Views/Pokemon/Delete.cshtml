@model pokecatalogo.Models.Pokemon
@{
    ViewData["Title"] = "Eliminar Pokémon";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4">
                <div class="d-flex flex-column align-items-center">
                    <img src="@Model.ImagemUrl" alt="@Model.Nome" class="mb-3" style="width: 100px; height: 100px; object-fit: contain; background: #fff; border-radius: 50%; border: 3px solid #FF0000; box-shadow: 0 2px 8px rgba(0,0,0,0.08);" />
                    <h2 class="fw-bold mb-1">@Model.Nome</h2>
                    <div class="mb-2">
                        @foreach (var tipo in Model.Tipos)
                        {
                            <span class="badge rounded-pill me-1" style="background:@tipo.Cor; color:#fff; font-size:1.1em;">@tipo.Nome</span>
                        }
                    </div>
                    <div class="text-muted mb-2">@Model.Especie</div>
                    <p class="text-center mb-3">@Model.DescricaoPokedex</p>
                    <div class="row w-100 mb-3">
                        <div class="col-6 text-center">
                            <span class="fw-semibold">Altura:</span> @Model.Altura m
                        </div>
                        <div class="col-6 text-center">
                            <span class="fw-semibold">Peso:</span> @Model.Peso kg
                        </div>
                    </div>
                    <h4 class="text-danger fw-bold mb-3 mt-2">Tem a certeza que deseja eliminar este Pokémon?</h4>
                    <form asp-action="Delete" class="w-100">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <input type="submit" value="Eliminar" class="btn btn-danger btn-lg rounded-pill px-5 shadow" />
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
