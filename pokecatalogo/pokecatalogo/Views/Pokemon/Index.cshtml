@model IEnumerable<pokecatalogo.Models.Pokemon>
@{
    ViewData["Title"] = "Pokémons";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold">Pokémons</h1>
    <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill shadow">+ Novo Pokémon</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
@foreach (var item in Model) {
    <div class="col">
        <div class="card h-100 shadow-sm border-0 rounded-4 pokemon-card">
            <div class="card-body d-flex flex-column align-items-center p-4">
                <img src="@item.ImagemUrl" alt="@item.Nome" class="mb-3" style="width: 96px; height: 96px; object-fit: contain; background: #fff; border-radius: 50%; border: 3px solid #FF0000; box-shadow: 0 2px 8px rgba(0,0,0,0.08);" />
                <h5 class="card-title fw-bold text-center mb-1">@item.Nome</h5>
                <div class="mb-2">
                    @foreach (var tipo in item.Tipos) {
                        <span class="badge rounded-pill me-1" style="background:@tipo.Cor; color:#fff; font-size:1em;">@tipo.Nome</span>
                    }
                </div>
                <div class="text-muted mb-2">@item.Especie</div>
                <p class="card-text text-center small mb-2" style="min-height: 48px;">@item.DescricaoPokedex?.Substring(0, Math.Min(item.DescricaoPokedex.Length, 70))@(item.DescricaoPokedex?.Length > 70 ? "..." : "")</p>
                <div class="d-flex justify-content-center gap-2 mt-auto">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<style>
.pokemon-card {
    transition: transform 0.15s, box-shadow 0.15s;
}
.pokemon-card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 8px 32px rgba(255,0,0,0.10), 0 2px 8px rgba(0,0,0,0.10);
}
</style>
