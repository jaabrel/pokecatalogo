@model pokecatalogo.Models.Pokemon

@{
    ViewData["Title"] = Model.Nome;
}

<div class="container py-5 d-flex flex-column align-items-center justify-content-center">
    <div class="card shadow-lg p-4 mb-4 w-100" style="max-width: 600px;">
        <div class="d-flex flex-column align-items-center">
            <img src="@Model.Imagem" alt="@Model.Nome" class="mb-3" style="width: 180px; height: 180px; object-fit: contain; background: #fff; border-radius: 50%; border: 4px solid #FF0000; box-shadow: 0 4px 24px rgba(0,0,0,0.10);"/>
            <h1 class="display-5 fw-bold mb-2">@Model.Nome</h1>
            <div class="mb-3">
                <span class="badge bg-danger bg-gradient fs-6 me-2">@Model.Tipo1?.Nome</span>
                @if (Model.Tipo2 != null)
                {
                    <span class="badge bg-secondary bg-gradient fs-6">@Model.Tipo2.Nome</span>
                }
            </div>
            @* Descrição (se existir) *@
            @if (!string.IsNullOrWhiteSpace(Model.Descricao))
            {
                <p class="text-center mb-3">@Model.Descricao</p>
            }
        </div>
    <hr />
        <h4 class="fw-bold">Estatísticas</h4>
        @if (Model.PokemonStats?.Any() == true)
        {
            var stats = Model.PokemonStats.First();
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">HP: <b>@stats.Hp</b></li>
                <li class="list-group-item">Ataque: <b>@stats.Atk</b></li>
                <li class="list-group-item">Defesa: <b>@stats.Def</b></li>
                <li class="list-group-item">Ataque Especial: <b>@stats.SpA</b></li>
                <li class="list-group-item">Defesa Especial: <b>@stats.SpD</b></li>
                <li class="list-group-item">Velocidade: <b>@stats.Speed</b></li>
            </ul>
        }
        <h4 class="fw-bold mt-4">Linha Evolutiva</h4>
        <div class="d-flex flex-wrap align-items-center justify-content-center mb-3">
            @if (Model.OrigemEvolucoes?.Any() == true)
            {
                foreach (var evo in Model.OrigemEvolucoes)
                {
                    <span class="me-2">@Model.Nome</span>
                    <span class="mx-2">→</span>
                    <span class="me-2">@evo.PokemonEvoluido?.Nome</span>
                }
            }
            else if (Model.FinalEvolucoes?.Any() == true)
            {
                foreach (var evo in Model.FinalEvolucoes)
                {
                    <span class="me-2">@evo.PokemonOrigem?.Nome</span>
                    <span class="mx-2">→</span>
                    <span class="me-2">@Model.Nome</span>
                }
            }
            else
            {
                <span>Este Pokémon não tem evoluções.</span>
            }
        </div>
        <h4 class="fw-bold mt-4">Ataques</h4>
        @if (Model.PokemonAtaques?.Any() == true)
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var pa in Model.PokemonAtaques)
                {
                    <li class="list-group-item">
                        <b>@pa.Ataque.Nome</b> <span class="badge bg-secondary">@pa.Ataque.Categoria</span> <span class="badge bg-info">@pa.Ataque.Tipo?.Nome</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Este Pokémon não tem ataques registados.</p>
        }
        <h4 class="fw-bold mt-4">Habilidades</h4>
        @if (Model.PokemonHabilidades?.Any() == true)
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var ph in Model.PokemonHabilidades)
                {
                    <li class="list-group-item">@ph.Habilidade.nome</li>
                }
            </ul>
        }
        <h4 class="fw-bold mt-4">Localizações</h4>
        @if (Model.PokemonLocalizacoes?.Any() == true)
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var pl in Model.PokemonLocalizacoes)
                {
                    <li class="list-group-item">@pl.Localizacao.Nome</li>
                }
            </ul>
        }
    </div>
</div>
<div class="text-center mb-5">
    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Voltar à lista</a>
</div>
