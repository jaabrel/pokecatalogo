@model Equipa
@{
    ViewData["Title"] = "Nova Equipa";
    var pokemons = ViewBag.Pokemons as SelectList;
    var ataques = ViewBag.Ataques as SelectList;
    var habilidades = ViewBag.Habilidades as SelectList;
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 520px; width: 100%;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold">Nova Equipa</h2>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <!-- Team Information -->
                <h5 class="fw-bold mb-3">Informações da Equipa</h5>
                <div class="mb-3">
                    <label asp-for="NomeEquipa" class="form-label fw-semibold"></label>
                    <input asp-for="NomeEquipa" class="form-control rounded-pill" />
                    <span asp-validation-for="NomeEquipa" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label fw-semibold"></label>
                    <textarea asp-for="Descricao" class="form-control rounded-4" rows="3"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>
                
                <!-- First Pokémon -->
                <h5 class="fw-bold mb-3">Primeiro Pokémon</h5>
                <div class="mb-3">
                    <label for="PokemonFk" class="form-label fw-semibold">Pokémon *</label>
                    <select id="PokemonFk" name="PokemonFk" class="form-select rounded-pill" required>
                        <option value="">Selecione um Pokémon</option>
                        @foreach (var p in pokemons)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="Nivel" class="form-label fw-semibold">Nível *</label>
                    <input type="number" id="Nivel" name="Nivel" class="form-control rounded-pill" min="1" max="100" value="50" required />
                </div>
                <div class="mb-3">
                    <label for="Alcunha" class="form-label fw-semibold">Alcunha (opcional)</label>
                    <input type="text" id="Alcunha" name="Alcunha" class="form-control rounded-pill" maxlength="50" />
                </div>
                <div class="mb-3">
                    <label for="PosicaoNaEquipa" class="form-label fw-semibold">Posição na Equipa *</label>
                    <select id="PosicaoNaEquipa" name="PosicaoNaEquipa" class="form-select rounded-pill" required>
                        <option value="">Selecione</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="HabilidadeFk" class="form-label fw-semibold">Habilidade (opcional)</label>
                    <select id="HabilidadeFk" name="HabilidadeFk" class="form-select rounded-pill">
                        <option value="">(Nenhuma)</option>
                        @foreach (var h in habilidades)
                        {
                            <option value="@h.Value">@h.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-4">
                    <label for="AtaquesFk" class="form-label fw-semibold">Ataques (máx. 4)</label>
                    <select id="AtaquesFk" name="AtaquesFk" class="form-select rounded-4" multiple size="6">
                        @foreach (var a in ataques)
                        {
                            <option value="@a.Value">@a.Text</option>
                        }
                    </select>
                    <div class="form-text">Segure Ctrl (Windows) ou Cmd (Mac) para selecionar múltiplos ataques.</div>
                </div>
                
                <div class="d-flex justify-content-between gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Criar Equipa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Limit attacks selection to 4
    document.getElementById('AtaquesFk').addEventListener('change', function() {
        if (this.selectedOptions.length > 4) {
            alert('Só pode selecionar até 4 ataques.');
            // Deselect the last selected
            this.selectedOptions[this.selectedOptions.length - 1].selected = false;
        }
    });
</script>
}

