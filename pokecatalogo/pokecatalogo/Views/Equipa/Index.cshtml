@model List<Equipa>
@{
    ViewData["Title"] = "Equipas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold">Minhas Equipas</h1>
    <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill shadow">+ Nova Equipa</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
@foreach (var equipa in Model) {
    <div class="col">
        <div class="card h-100 shadow-sm border-0 rounded-4 equipa-card">
            <div class="card-body d-flex flex-column align-items-center p-4">
                <h5 class="card-title fw-bold text-center mb-1">@equipa.NomeEquipa</h5>
                <div class="mb-2 text-muted small">Criada em: @equipa.DataCriacao.ToShortDateString()</div>
                <div class="mb-2 text-center">@equipa.Descricao</div>
                <div class="mb-2">
                    <span class="fw-semibold">Pokémons:</span>
                    @if (equipa.Pokemons != null && equipa.Pokemons.Any()) {
                        <ul class="list-unstyled mb-0">
                        @foreach (var pe in equipa.Pokemons.OrderBy(p => p.PosicaoNaEquipa)) {
                            <li>
                                <span class="badge bg-primary rounded-pill">@pe.Pokemon?.Nome ?? "?"</span>
                                <span class="text-muted small">(Nível @pe.Nivel)</span>
                                @if (!string.IsNullOrEmpty(pe.Alcunha)) {
                                    <span class="text-muted small">- "@pe.Alcunha"</span>
                                }
                            </li>
                        }
                        </ul>
                    } else {
                        <span class="text-muted">Nenhum Pokémon na equipa</span>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2 mt-auto">
                    <a asp-action="Details" asp-route-id="@equipa.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@equipa.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3">Editar</a>
                    <a asp-action="Delete" asp-route-id="@equipa.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<style>
.equipa-card {
    transition: transform 0.15s, box-shadow 0.15s;
}
.equipa-card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 8px 32px rgba(255,0,0,0.10), 0 2px 8px rgba(0,0,0,0.10);
}
</style>
