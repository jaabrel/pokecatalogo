@model Equipa
@{
    ViewData["Title"] = "Eliminar Equipa";
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-lg border-0 rounded-4 p-4 border-danger" style="max-width: 480px; width: 100%;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold text-danger">Eliminar Equipa</h2>
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Atenção:</strong> Esta ação não pode ser desfeita. A equipa e todos os seus Pokémons serão eliminados permanentemente.
            </div>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Nome da Equipa:</span> <span>@Model.NomeEquipa</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Descrição:</span> <span>@Model.Descricao</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Data de Criação:</span> <span>@Model.DataCriacao.ToShortDateString()</span></li>
                <li class="list-group-item d-flex flex-column">
                    <span class="fw-semibold mb-1">Pokémons na equipa:</span>
                    @if (Model.Pokemons != null && Model.Pokemons.Any()) {
                        <ul class="list-unstyled mb-0">
                        @foreach (var pe in Model.Pokemons.OrderBy(p => p.PosicaoNaEquipa)) {
                            <li>
                                <span class="badge bg-primary rounded-pill">@pe.Pokemon?.Nome ?? "?"</span>
                                <span class="text-muted small">(Nível @pe.Nivel)</span>
                                @if (!string.IsNullOrEmpty(pe.Alcunha)) {
                                    <span class="text-muted small">- "@pe.Alcunha"</span>
                                }
                            </li>
                        }
                        </ul>
                    } else {
                        <span class="text-muted">Nenhum Pokémon na equipa</span>
                    }
                </li>
            </ul>
            <form asp-action="Delete" class="d-flex justify-content-between gap-2 mt-3">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Eliminar Equipa</button>
            </form>
        </div>
    </div>
</div>
