@model pokecatalogo.Models.Utilizadores
@{
    ViewData["Title"] = "Detalhes do Utilizador";
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 480px; width: 100%;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold">Detalhes do Utilizador</h2>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Nome:</span> <span>@Model.Nome</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">UserName:</span> <span>@Model.IdentityUserName</span></li>
            </ul>
            <div class="d-flex justify-content-between gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning rounded-pill px-4">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Voltar</a>
            </div>
        </div>
    </div>
</div>
