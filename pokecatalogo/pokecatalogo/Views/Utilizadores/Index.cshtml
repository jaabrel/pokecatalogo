@model IEnumerable<pokecatalogo.Models.Utilizadores>
@{
    ViewData["Title"] = "Utilizadores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold">Utilizadores</h1>
    <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill shadow">+ Novo Utilizador</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
@foreach (var item in Model) {
    <div class="col">
        <div class="card h-100 shadow-sm border-0 rounded-4 utilizador-card">
            <div class="card-body d-flex flex-column align-items-center p-4">
                <h5 class="card-title fw-bold text-center mb-1">@item.Nome</h5>
                <div class="mb-2 w-100 text-center">
                    <div class="small"><span class="fw-semibold">UserName:</span> @item.IdentityUserName</div>
                </div>
                <div class="d-flex justify-content-center gap-2 mt-auto">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<style>
.utilizador-card {
    transition: transform 0.15s, box-shadow 0.15s;
}
.utilizador-card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 8px 32px rgba(255,0,0,0.10), 0 2px 8px rgba(0,0,0,0.10);
}
</style>
