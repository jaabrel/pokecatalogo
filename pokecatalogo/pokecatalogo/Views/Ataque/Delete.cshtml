@model pokecatalogo.Models.Ataque
@{
    ViewData["Title"] = "Eliminar Ataque";
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-lg border-0 rounded-4 p-4 border-danger" style="max-width: 480px; width: 100%;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold text-danger">Eliminar Ataque</h2>
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Atenção:</strong> Esta ação não pode ser desfeita. O ataque será eliminado permanentemente.
            </div>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Nome:</span> <span>@Model.Nome</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Categoria:</span> <span>@Model.Categoria</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Descrição:</span> <span>@Model.Descricao</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Dano:</span> <span>@Model.Dano</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Precisão:</span> <span>@Model.Precisao</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">PP:</span> <span>@Model.PP</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Prioridade:</span> <span>@Model.Prioridade</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Tipo:</span> <span>@Model.Tipo?.Nome</span></li>
            </ul>
            <form asp-action="Delete" class="d-flex justify-content-between gap-2 mt-3">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Eliminar</button>
            </form>
        </div>
    </div>
</div>
