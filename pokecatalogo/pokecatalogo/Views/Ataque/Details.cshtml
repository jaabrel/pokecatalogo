@model pokecatalogo.Models.Ataque
@{
    ViewData["Title"] = "Detalhes do Ataque";
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 480px; width: 100%;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold">@Model.Nome</h2>
            <div class="mb-3 text-center">
                <span class="badge rounded-pill me-1" style="background:@Model.Tipo?.Cor ?? '#888'; color:#fff; font-size:1em;">@Model.Tipo?.Nome</span>
                <span class="badge bg-secondary rounded-pill">@Model.Categoria</span>
            </div>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Descrição:</span> <span>@Model.Descricao</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Dano:</span> <span>@Model.Dano</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Precisão:</span> <span>@Model.Precisao</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">PP:</span> <span>@Model.PP</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="fw-semibold">Prioridade:</span> <span>@Model.Prioridade</span></li>
            </ul>
            <div class="d-flex justify-content-between gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning rounded-pill px-4">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Voltar</a>
            </div>
        </div>
    </div>
</div>
