@model IEnumerable<pokecatalogo.Models.Tipo>
@{
    ViewData["Title"] = "Tipos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold">Tipos</h1>
    <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill shadow">+ Novo Tipo</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
@foreach (var item in Model) {
    <div class="col">
        <div class="card h-100 shadow-sm border-0 rounded-4 tipo-card">
            <div class="card-body d-flex flex-column align-items-center p-4">
                <span class="badge rounded-pill mb-2" style="background:@item.Cor; color:#fff; font-size:1.2em;">@item.Nome</span>
                <div class="mb-2 w-100">
                    <div class="small"><span class="fw-semibold">Fraquezas:</span> @item.Fraquezas</div>
                    <div class="small"><span class="fw-semibold">Resistências:</span> @item.Resistências</div>
                    <div class="small"><span class="fw-semibold">Imunidades:</span> @item.Imunidades</div>
                    <div class="small"><span class="fw-semibold">Efetivo:</span> @item.Efetivo</div>
                </div>
                <div class="d-flex justify-content-center gap-2 mt-auto">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<style>
.tipo-card {
    transition: transform 0.15s, box-shadow 0.15s;
}
.tipo-card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 8px 32px rgba(255,0,0,0.10), 0 2px 8px rgba(0,0,0,0.10);
}
</style>
